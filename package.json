{
  "name": "call-and-response",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @call-and-response/web",
    "build": "npm run build -w @call-and-response/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint apps/web/src packages/shared/src",
    "test": "vitest run",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "globals": "^16.0.0",
    "playwright-core": "^1.64.1",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^3.0.0"
  }
}
